PORT=5000
# JWT साठी मोठी random string वापरा
JWT_SECRET=change-me-very-long-random-secret
# AES-256 साठी 64 hex characters (32 bytes). तयार करण्यासाठी:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# strict = वॉर्डबाहेर हजेरी नाकारली जाईल, warn = हजेरी घेतली जाईल पण flag होईल
GEOFENCE_MODE=warn
# React app चा URL (WhatsApp लिंकसाठी व CORS साठी)
APP_URL=http://localhost:5173
# WhatsApp Cloud API (रिकामे ठेवल्यास मेसेज फक्त console/DB मध्ये लॉग होतात)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SLA तपासणी किती सेकंदांनी चालवायची
SLA_CHECK_SECONDS=60
# दररोज backup किती वाजता (24 तास फॉरमॅट)
BACKUP_HOUR=2
# WhatsApp webhook verify token (Meta console मध्ये हाच टाका)
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
# Meta App Secret — webhook मेसेज खरे आहेत का ते तपासण्यासाठी (production मध्ये आवश्यक)
WHATSAPP_APP_SECRET=
# दैनिक MIS PDF अहवाल किती वाजता पाठवायचा (भारतीय वेळ, २४ तास)
REPORT_HOUR=18
# ई-मेल (रिकामे असल्यास मेल console मध्ये लॉग होतात)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Web Push (रिकामे असल्यास data/vapid.json मध्ये आपोआप तयार होतात)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com
# वाहन मार्ग अलर्ट
OFF_ROUTE_GRACE_SECONDS=120
OVERSPEED_KMPH=50
